<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.project.platform.mapper.ChapterMapper">

    <select id="queryPage" resultType="com.project.platform.entity.Chapter">
        SELECT chapter.*
        FROM chapter
        <include refid="queryConditions"/>
        ORDER BY chapter.sort_order ASC, chapter.id DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="queryCount" resultType="int">
        SELECT count(chapter.id) FROM chapter
        <include refid="queryConditions"/>
    </select>

    <sql id="queryConditions">
        <where>
            <if test="query.courseId != null">
                AND chapter.course_id = #{query.courseId}
            </if>
            <if test="query.chapterName != null and query.chapterName.trim() != ''">
                AND chapter.chapter_name LIKE CONCAT('%', #{query.chapterName}, '%')
            </if>
        </where>
    </sql>

    <select id="selectById" resultType="com.project.platform.entity.Chapter">
        SELECT * FROM chapter WHERE id = #{id}
    </select>

    <select id="listByCourseId" resultType="com.project.platform.entity.Chapter">
        SELECT * FROM chapter
        WHERE course_id = #{courseId}
        ORDER BY sort_order ASC, id DESC
    </select>

    <select id="listByCourseIds" resultType="com.project.platform.entity.Chapter">
        SELECT * FROM chapter
        WHERE course_id IN
        <foreach collection="courseIds" item="courseId" open="(" separator="," close=")">
            #{courseId}
        </foreach>
        ORDER BY sort_order ASC, id DESC
    </select>

    <select id="selectByCourseIdAndName" resultType="com.project.platform.entity.Chapter">
        SELECT * FROM chapter
        WHERE course_id = #{courseId} AND chapter_name = #{chapterName}
        LIMIT 1
    </select>

    <!-- 插入（无 content_url） -->
    <insert id="insert" parameterType="com.project.platform.entity.Chapter" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO chapter
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="courseId != null">course_id,</if>
            <if test="chapterName != null">chapter_name,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="courseId != null">#{courseId},</if>
            <if test="chapterName != null">#{chapterName},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <!-- 更新（无 content_url） -->
    <update id="updateById" parameterType="com.project.platform.entity.Chapter">
        UPDATE chapter
        <set>
            <if test="courseId != null">
                course_id = #{courseId},
            </if>
            <if test="chapterName != null">
                chapter_name = #{chapterName},
            </if>
            <if test="sortOrder != null">
                sort_order = #{sortOrder},
            </if>
            <if test="createTime != null">
                create_time = #{createTime},
            </if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 批量删除 -->
    <delete id="removeByIds">
        DELETE FROM chapter
        WHERE id IN
        <foreach item="id" collection="list" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>